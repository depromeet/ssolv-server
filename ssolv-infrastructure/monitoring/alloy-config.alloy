// 1. 메트릭 수집
prometheus.scrape "node_exporter" {
  targets = [
    {"__address__" = "node-exporter:9100", "instance" = "instance-b"},
    {"__address__" = sys.env("INSTANCE_A_PRIVATE_IP") + ":9100", "instance" = "instance-a"},
  ]
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.scrape "spring_boot" {
  targets    = [
    // 인스턴스 B 로컬 app-server
    {"__address__" = "app-server:8080", "application" = "ssolv-api", "service" = "ssolv-api", "instance" = "instance-b"},
    // 인스턴스 A app-server — B의 Alloy가 사설 IP로 원격 스크레이프
    {"__address__" = sys.env("INSTANCE_A_PRIVATE_IP") + ":8080", "application" = "ssolv-api", "service" = "ssolv-api", "instance" = "instance-a"},
  ]

  metrics_path = "/actuator/prometheus"
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.scrape "nginx_exporter" {
  targets = [
    {"__address__" = "nginx-exporter:9113", "instance" = "instance-b"},
    {"__address__" = sys.env("INSTANCE_A_PRIVATE_IP") + ":9113", "instance" = "instance-a"},
  ]
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.scrape "redis_exporter" {
  targets    = [{"__address__" = "redis-exporter:9121", "instance" = "instance-b"}]
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROMETHEUS_URL")
    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USER")
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}

// 2. 로그 수집
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    replacement  = "instance-b"
    target_label = "instance"
  }
}

loki.source.docker "logs" {
  host      = "unix:///var/run/docker.sock"
  targets   = discovery.relabel.docker_logs.output
  forward_to = [loki.process.labels.receiver]
}

loki.process "labels" {
  stage.docker { }

  // app-server MDC 필드 추출 → structured metadata (JSON 로그 파싱)
  stage.match {
    selector = "{container=\"app-server\"}"

    // 1단계: JSON 최상위 필드 추출 (LogstashEncoder 출력)
    stage.json {
      expressions = {
        request_id  = "request_id",
        user_id     = "user_id",
        trace_id    = "traceId",
        log_message = "message",
      }
    }

    // 2단계: message 필드에서 HTTP 요청 메타데이터 추출
    stage.regex {
      expression = `HTTP Request Completed - status=(?P<status>\d+) method=(?P<method>\w+) uri=(?P<uri>[^ ]+)`
      source     = "log_message"
    }

    stage.structured_metadata {
      values = {
        request_id = "request_id",
        user_id    = "user_id",
        trace_id   = "trace_id",
        method     = "method",
        uri        = "uri",
        status     = "status",
      }
    }
  }

  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")
    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USER")
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}

// 3. 트레이싱 수집

// OTLP 수신기
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces  = [otelcol.processor.batch.default.input]
  }
}

// 배치 처리
otelcol.processor.batch "default" {
  output {
    traces  = [otelcol.exporter.otlp.grafana_cloud.input]
  }
}

// Grafana Cloud Tempo로 전송
otelcol.exporter.otlp "grafana_cloud" {
  client {
    endpoint = sys.env("GRAFANA_CLOUD_TEMPO_URL")
    auth     = otelcol.auth.basic.grafana_cloud.handler
  }
}

otelcol.auth.basic "grafana_cloud" {
  username = sys.env("GRAFANA_CLOUD_TEMPO_USER")
  password = sys.env("GRAFANA_CLOUD_API_KEY")
}