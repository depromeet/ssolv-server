{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" },
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "barchart", "name": "Bar chart", "version": "" },
    { "type": "panel", "id": "logs", "name": "Logs", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Claude Code 워크플로우 모니터링 — Skill 호출, Command 사용, Hook 블록 이벤트",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"] } },
      "title": "Skill 호출 횟수",
      "type": "stat",
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "sum(count_over_time({service_name=\"claude-code\",developer=~\"$developer\"} |= \"skill.invoked\" [$__range]))",
        "legendFormat": "invocations"
      }]
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"] } },
      "title": "Hook 블록 횟수",
      "type": "stat",
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "sum(count_over_time({service_name=\"claude-code\",developer=~\"$developer\"} |= \"hook.blocked\" [$__range]))",
        "legendFormat": "blocks"
      }]
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"] } },
      "title": "Command 사용 횟수",
      "type": "stat",
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "sum(count_over_time({service_name=\"claude-code\",developer=~\"$developer\"} |= \"command.invoked\" [$__range]))",
        "legendFormat": "commands"
      }]
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 20 }, { "color": "red", "value": 40 }] },
          "unit": "percent",
          "decimals": 1
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Hook 블록률 (Skill 대비)",
      "type": "stat",
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "100 * sum(count_over_time({service_name=\"claude-code\",developer=~\"$developer\"} |= \"hook.blocked\" [$__range])) / clamp_min(sum(count_over_time({service_name=\"claude-code\",developer=~\"$developer\"} |= \"skill.invoked\" [$__range])), 1)",
        "legendFormat": "block rate"
      }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Skill 호출 추이",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 6 },
      "id": 10,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Skill 호출 추이 (시간별)",
      "type": "timeseries",
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "sum by (skill_name) (count_over_time({service_name=\"claude-code\",developer=~\"$developer\"} |= \"skill.invoked\" | json [$__interval]))",
        "legendFormat": "{{skill_name}}"
      }]
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 6 },
      "id": 11,
      "title": "Skill 사용 빈도 Top 10",
      "type": "barchart",
      "options": { "orientation": "horizontal", "barWidth": 0.7, "tooltip": { "mode": "multi" } },
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "topk(10, sum by (skill_name) (count_over_time({service_name=\"claude-code\",developer=~\"$developer\"} |= \"skill.invoked\" | json [$__range])))",
        "legendFormat": "{{skill_name}}"
      }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Hook 블록 이벤트",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "commit-msg-check" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "module-import-check" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "value-injection-check" }, "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "controller-annotation-check" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 15 },
      "id": 20,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Hook 블록 추이 (훅별)",
      "type": "timeseries",
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "sum by (hook_name) (count_over_time({service_name=\"claude-code\",developer=~\"$developer\"} |= \"hook.blocked\" | json [$__interval]))",
        "legendFormat": "{{hook_name}}"
      }]
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 15 },
      "id": 21,
      "title": "블록 사유 분포",
      "type": "barchart",
      "options": { "orientation": "horizontal", "barWidth": 0.7, "tooltip": { "mode": "multi" } },
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "sum by (reason) (count_over_time({service_name=\"claude-code\",developer=~\"$developer\"} |= \"hook.blocked\" | json [$__range]))",
        "legendFormat": "{{reason}}"
      }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "title": "Raw Event Logs",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 24 },
      "id": 30,
      "title": "Skill 호출 로그",
      "type": "logs",
      "options": { "dedupStrategy": "none", "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "{service_name=\"claude-code\",developer=~\"$developer\"} |= \"skill.invoked\" | json | line_format \"[{{.skill_name}}] project={{.project}}\"",
        "legendFormat": ""
      }]
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 24 },
      "id": 31,
      "title": "Hook 블록 로그",
      "type": "logs",
      "options": { "dedupStrategy": "none", "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "{service_name=\"claude-code\",developer=~\"$developer\"} |= \"hook.blocked\" | json | line_format \"[{{.hook_name}}] {{.reason}}\"",
        "legendFormat": ""
      }]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 38,
  "tags": ["claude-code", "workflow", "ssolv"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "parkmineum", "value": "parkmineum" },
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "definition": "label_values({service_name=\"claude-code\"}, developer)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "developer",
        "options": [],
        "query": "label_values({service_name=\"claude-code\"}, developer)",
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "label": "Developer"
      }
    ]
  },
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Claude Code — Workflow Monitoring",
  "uid": "claude-code-workflow",
  "version": 1
}
