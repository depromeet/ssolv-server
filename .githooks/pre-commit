#!/bin/bash
# ssolv pre-commit hook
# 커밋 전 빠른 스타일 검증 (ktlint, ~3초)
# 실패 시 커밋 차단

set -e

echo "🔍 Pre-commit: ktlintCheck 실행..."

./gradlew ktlintCheck --daemon -q

STATUS=$?
if [ $STATUS -ne 0 ]; then
  echo ""
  echo "❌ ktlint 검증 실패."
  echo "   수정: ./gradlew ktlintFormat"
  echo "   그 후 다시 git add + git commit"
  exit 1
fi

echo "✅ Pre-commit: ktlint 통과"
